# Copy this file to .env and fill in your values. Never commit .env to GitHub.

# Which LLM to use: azure or openai
LLM_PROVIDER=azure

# --- Azure OpenAI (used when LLM_PROVIDER=azure) ---
# Endpoint from the Azure portal, for example https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# The DEPLOYMENT name you gave the model in Azure AI Foundry (not the model family name)
AZURE_OPENAI_DEPLOYMENT=
# Leave empty to use the v1 endpoint. Only fill in if your resource needs an api-version, e.g. 2024-10-21
AZURE_OPENAI_API_VERSION=

# --- OpenAI platform (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Business rules ---
# Any exception with this much money at stake, or more, needs a human approver
APPROVAL_THRESHOLD=50000
CURRENCY=INR
# Only used for the "hours saved" estimate on the Impact tab
MANUAL_MINUTES_PER_EXCEPTION=25
